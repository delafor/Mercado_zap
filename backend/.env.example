# Copy to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# AbacatePay — https://app.abacatepay.com
ABACATEPAY_KEY=your_abacatepay_key_here
# Secret AbacatePay sends back as ?webhookSecret= on webhook calls
ABACATEPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Infra (matches docker-compose.yml)
DATABASE_URL=postgres://mercadozap:mercadozap@localhost:5432/mercadozap
REDIS_URL=redis://localhost:6379
